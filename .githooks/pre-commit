#!/usr/bin/env bash
# .githooks/pre-commit
# Enforces clean compilation and domain architectural boundaries before commits.

echo "[pre-commit] Checking staged files..."

# Check if any ActionScript sources or compile assets are staged
STAGED_AS3=$(git diff --cached --name-only | grep -E '^src/as3/.*\.as$')

if [ -z "$STAGED_AS3" ]; then
    echo "[pre-commit] No ActionScript sources staged. Fast-path skipping compiler verification."
    exit 0
fi

echo "[pre-commit] ActionScript changes detected in staged commit:"
echo "$STAGED_AS3" | sed 's/^/  - /'

# 1. Run Domain Boundary Linter (if present)
if [ -f "scripts/lint_domain_leakage.py" ]; then
    echo "[pre-commit] Running domain architecture linter..."
    python scripts/lint_domain_leakage.py --staged
    LINT_STATUS=$?
    if [ $LINT_STATUS -ne 0 ]; then
        echo ""
        echo "================================================================"
        echo " [pre-commit ERROR] Domain boundary lint check failed."
        echo " Please encapsulate domain logic before committing."
        echo "================================================================"
        exit 1
    fi
fi

# 2. Run Recompilation verification
echo "[pre-commit] Running SWF recompilation verification..."
if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "win32" || -n "$COMSPEC" ]]; then
    cmd.exe /c "scripts\\recompile.bat"
    BUILD_STATUS=$?
else
    sh scripts/recompile.sh
    BUILD_STATUS=$?
fi

if [ $BUILD_STATUS -ne 0 ]; then
    echo ""
    echo "================================================================"
    echo " [pre-commit ERROR] ActionScript compilation failed (exit code $BUILD_STATUS)."
    echo " Commit aborted. Please resolve compiler errors before committing."
    echo "================================================================"
    exit 1
fi

echo "[pre-commit] All pre-commit checks passed successfully!"
exit 0
