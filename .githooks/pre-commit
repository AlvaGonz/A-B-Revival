#!/usr/bin/env sh
# .githooks/pre-commit
# Enforces automated testing and architectural boundaries before commits (ADR 0015, ADR 0016).

echo "[pre-commit] Checking staged files..."

# 1. Check for staged Unity 6.6 changes (A&B-U/)
STAGED_UNITY=$(git diff --cached --name-only | grep -E '^A&B-U/')

if [ -n "$STAGED_UNITY" ]; then
    echo "[pre-commit] Unity 6.6 changes detected. Running Tier 1 automated test suite (ADR 0016)..."
    dotnet test "A&B-U/Assets/Scripts/Tests/ABRevival.Tests.csproj" --nologo -v q
    TEST_STATUS=$?
    if [ $TEST_STATUS -ne 0 ]; then
        echo ""
        echo "================================================================"
        echo " [pre-commit ERROR] Tier 1 .NET unit test suite failed (exit code $TEST_STATUS)."
        echo " Please ensure all tests pass (Zero-Error Verification Gate) before committing."
        echo "================================================================"
        exit 1
    fi
    echo "[pre-commit] Tier 1 test suite passed successfully."
fi

# 2. Check for staged legacy ActionScript sources (src/as3/)
STAGED_AS3=$(git diff --cached --name-only | grep -E '^src/as3/.*\.as$')

if [ -n "$STAGED_AS3" ]; then
    echo "================================================================"
    echo " [pre-commit WARNING] Changes detected in src/as3/."
    echo " Note: ActionScript 3 is frozen as a read-only baseline per ADR 0015."
    echo "================================================================"
    
    if [ -f "scripts/lint_domain_leakage.py" ]; then
        echo "[pre-commit] Running domain architecture linter..."
        python scripts/lint_domain_leakage.py --staged
        LINT_STATUS=$?
        if [ $LINT_STATUS -ne 0 ]; then
            echo "[pre-commit ERROR] Domain boundary lint check failed."
            exit 1
        fi
    fi
fi

# 3. Check for staged batch shell scripts (*.bat)
STAGED_BAT=$(git diff --cached --name-only | grep -E '\.bat$')

if [ -n "$STAGED_BAT" ]; then
    echo "[pre-commit] Staged .bat scripts detected. Running shell script quoting linter..."
    python scripts/lint_shell_scripts.py --staged
    LINT_BAT_STATUS=$?
    if [ $LINT_BAT_STATUS -ne 0 ]; then
        echo ""
        echo "================================================================"
        echo " [pre-commit ERROR] Batch script lint check failed."
        echo " Enforce set \"VAR=...\" and escape ampersands with ^&."
        echo "================================================================"
        exit 1
    fi
    echo "[pre-commit] Shell script linter passed successfully."
fi

# 4. If nothing requiring gates was staged
if [ -z "$STAGED_UNITY" ] && [ -z "$STAGED_AS3" ] && [ -z "$STAGED_BAT" ]; then
    echo "[pre-commit] Documentation or metadata changes staged. Skipping test runner."
fi

echo "[pre-commit] All pre-commit checks passed successfully!"
exit 0
