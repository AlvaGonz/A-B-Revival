/* Combat HUD (frozen 2011 layout, ADR 0004/0005).
 * Authored at the ticket #179 single 3x design scale: 640x480 frozen stage coordinates
 * multiplied by 3, on the 1920x1080 design canvas. Positions follow UI_Game symbol 510.
 * The world uses the same 3x scale (CameraDistancePresets.DesignScale).
 * Frozen plates are authored in CombatHud.uxml as app:SpriteElement (ADR 0025). */

/* UXML art layers fill their host without joining its layout (Info pattern). */
.art-layer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.hud-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ---- top-left: money, pause, help ---- */

.hud-money-panel {
    position: absolute;
    left: 15px;
    top: 19px;
    width: 471px;
    height: 75px;
}

.hud-money-text {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 3px;
    bottom: 3px;
    font-size: 40px;
    color: rgb(110, 232, 244);
    -unity-text-align: middle-center;
}

.hud-icon-button {
    position: absolute;
    top: 19px;
    width: 75px;
    height: 75px;
}

.hud-pause {
    left: 495px;
}

.hud-help {
    left: 591px;
}

/* ---- top-right: radar, distance, mission timer, AI count ---- */

.hud-radar {
    position: absolute;
    right: 12px;
    top: 15px;
    width: 288px;
    height: 357px;
}

.hud-radar-arrow {
    position: absolute;
    left: 89px;
    top: 72px;
    width: 135px;
    height: 93px;
    transform-origin: center;
}

.hud-radar-readout {
    position: absolute;
    left: 0;
    right: 0;
    top: 240px;
    height: 60px;
    font-size: 35px;
    color: rgb(220, 236, 255);
    -unity-text-align: middle-center;
}

.hud-radar-timer {
    position: absolute;
    left: 0;
    right: 0;
    top: 300px;
    height: 57px;
    font-size: 32px;
    color: rgb(110, 232, 244);
    -unity-text-align: middle-center;
}

.hud-ai-count {
    position: absolute;
    right: 12px;
    top: 373px;
    width: 288px;
    height: 75px;
}

.hud-badge-text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 40px;
    color: rgb(240, 248, 255);
    -unity-text-align: middle-center;
}

/* ---- bottom-left: pilot portrait, bars, telemetry ---- */

.hud-pilot-tile {
    position: absolute;
    left: 15px;
    bottom: 0;
    width: 147px;
}

.hud-pilot-portrait {
    width: 147px;
    height: 153px;
}

.hud-pilot-name {
    width: 147px;
    height: 43px;
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0.85);
}

.hud-telemetry {
    position: absolute;
    left: 132px;
    bottom: 165px;
    width: 547px;
    height: 99px;
}

.hud-telemetry-text {
    position: absolute;
    left: 13px;
    right: 13px;
    top: 0;
    bottom: 0;
    font-size: 29px;
    color: rgb(255, 196, 120);
    -unity-text-align: middle-center;
}

.hud-bars {
    position: absolute;
    left: 132px;
    bottom: 48px;
    width: 547px;
    height: 99px;
    -unity-background-scale-mode: stretch-to-fill;
}

.hud-bar {
    height: 21px;
    margin-bottom: 17px;
}

.hud-bar-fill {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 100%;
}

.hud-health-fill {
    background-color: rgb(200, 32, 40);
}

.hud-fuel-fill {
    background-color: rgb(60, 150, 255);
}

/* Third bar: visible track, inert fill, reserved. Never bound to a value. */
.hud-reserved-fill {
    width: 0;
    background-color: rgb(150, 200, 40);
}

.hud-portrait-backing {
    position: absolute;
    left: 0;
    top: 0;
    width: 147px;
    height: 153px;
    -unity-background-scale-mode: scale-to-fit;
}

.hud-portrait-pip {
    position: absolute;
    right: 5px;
    top: 5px;
    width: 29px;
    height: 29px;
}

.hud-hull-value {
    position: absolute;
    right: 11px;
    /* SF TransRobotics' 1em line box needs 25px over the 21px health bar. */
    top: -3px;
    height: 25px;
    font-size: 20px;
    color: rgb(255, 236, 236);
    -unity-text-align: middle-right;
}

/* ---- bottom-right: minimap and Captain portrait ---- */

.hud-minimap {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 511px;
    height: 528px;
}

.hud-captain-tile {
    position: absolute;
    right: 540px;
    bottom: 0;
    width: 147px;
}

.hud-captain-portrait {
    width: 147px;
    height: 153px;
}

.hud-captain-health-track {
    width: 147px;
    height: 21px;
    background-color: rgba(24, 28, 34, 0.9);
}

.hud-captain-health {
    height: 21px;
    width: 100%;
    background-color: rgb(200, 32, 40);
}

.hud-captain-code {
    width: 147px;
    height: 43px;
    font-size: 32px;
    color: rgb(255, 204, 0);
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0.85);
}

/* ---- bottom-center: tactical-mode and camera-distance badges ---- */

.hud-badges {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 24px;
    flex-direction: row;
    justify-content: center;
}

.hud-mode-badge {
    width: 288px;
    height: 75px;
    margin-right: 12px;
}

.hud-camera-badge {
    width: 288px;
    height: 75px;
    margin-left: 12px;
}

.hud-badge-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    font-size: 29px;
    color: rgb(140, 240, 250);
    -unity-text-align: middle-center;
}

/* ADR 0005 badge wording is long; 23px keeps it inside the 288px plate. */
.hud-camera-badge .hud-badge-label {
    font-size: 23px;
}

/* ---- center reticle ---- */

.hud-reticle {
    position: absolute;
    left: 1199px;
    top: 667px;
    width: 163px;
    height: 108px;
    translate: -52px -53px;
}
