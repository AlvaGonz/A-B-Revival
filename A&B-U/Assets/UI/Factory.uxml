<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xmlns:app="ABRevival.Presentation" editor-extension-mode="False">
    <Style src="Factory.uss" />
    <ui:VisualElement name="factory-root" class="factory-root">
        <app:SpriteElement name="factory-background" class="art-layer" scale-mode="StretchToFill" sprite="project://database/Assets/Art/Sprites/UI/ui_0312_hangar_background.png" />
        <ui:VisualElement name="factory-screen" class="factory-screen">
            <ui:VisualElement name="factory-header" class="factory-header">
                <app:SpriteElement name="factory-header-art" class="art-layer" scale-mode="StretchToFill" sprite="project://database/Assets/Art/Sprites/UI/ui_0107_hangar_header.png" />
                <ui:Label name="factory-title" text="Edit" class="factory-title" />
            </ui:VisualElement>

            <ui:VisualElement name="factory-body" class="factory-body">
                <ui:VisualElement name="undo-strip" class="undo-strip font-sans">
                    <ui:Button name="undo-0" text="-" class="undo-button" tooltip="Removed part" />
                    <ui:Button name="undo-1" text="-" class="undo-button" tooltip="Removed part" />
                    <ui:Button name="undo-2" text="-" class="undo-button" tooltip="Removed part" />
                    <ui:Button name="undo-3" text="-" class="undo-button" tooltip="Removed part" />
                    <ui:Button name="undo-4" text="-" class="undo-button" tooltip="Removed part" />
                    <ui:Button name="undo-5" text="-" class="undo-button" tooltip="Removed part" />
                    <ui:Button name="undo-6" text="-" class="undo-button" tooltip="Removed part" />
                    <ui:Button name="undo-7" text="-" class="undo-button" tooltip="Removed part" />
                    <ui:Button name="undo-8" text="-" class="undo-button" tooltip="Removed part" />
                    <ui:Button name="undo-9" text="-" class="undo-button" tooltip="Removed part" />
                    <ui:Button name="undo-10" text="-" class="undo-button" tooltip="Removed part" />
                    <ui:Button name="undo-11" text="-" class="undo-button" tooltip="Removed part" />
                </ui:VisualElement>

                <ui:VisualElement class="preview-column">
                    <ui:VisualElement name="preview-frame" class="preview-frame">
                        <app:SpriteElement name="preview-frame-art" class="art-layer" scale-mode="StretchToFill" sprite="project://database/Assets/Art/Sprites/UI/ui_0315_hangar_frame.png" />
                        <ui:VisualElement name="preview-clip" class="preview-clip">
                            <ui:VisualElement name="preview-canvas" class="preview-canvas" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="preview-name" text="-" class="preview-name" />
                    <ui:VisualElement class="preview-actions">
                        <ui:Button name="merge-button" class="sprite-button action-button" tooltip="Merge this craft">
                            <app:SpriteElement name="button-art" class="button-art" scale-mode="ScaleAndCrop" sprite="project://database/Assets/Art/Sprites/UI/ui_0364_hangar_button_merge.png" />
                        </ui:Button>
                        <ui:Button name="new-button" class="sprite-button action-button" tooltip="Break this craft to parts">
                            <app:SpriteElement name="button-art" class="button-art" scale-mode="ScaleAndCrop" sprite="project://database/Assets/Art/Sprites/UI/ui_0361_hangar_button_new.png" />
                        </ui:Button>
                        <ui:Button name="add-button" class="sprite-button action-button" tooltip="Add as a new craft">
                            <app:SpriteElement name="button-art" class="button-art" scale-mode="ScaleAndCrop" sprite="project://database/Assets/Art/Sprites/UI/ui_0356_hangar_button_add.png" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="detail-column">
                    <ui:VisualElement class="view-controls">
                        <ui:Button name="help-button" class="sprite-button help-button" tooltip="Help">
                            <app:SpriteElement name="button-art" class="button-art" scale-mode="ScaleAndCrop" sprite="project://database/Assets/Art/Sprites/UI/ui_0073_hud_button_help.png" />
                        </ui:Button>
                        <ui:Button name="zoom-in-button" text="+" class="zoom-button" tooltip="Zoom in" />
                        <ui:Button name="zoom-out-button" text="-" class="zoom-button" tooltip="Zoom out" />
                        <ui:Button name="center-view-button" text="C" class="zoom-button" tooltip="Center view" />
                    </ui:VisualElement>
                    <ui:VisualElement class="detail-spacer" />
                    <ui:VisualElement name="detail-card" class="detail-card font-data">
                        <ui:VisualElement class="detail-row">
                            <ui:Label text="Hp" class="detail-key" />
                            <ui:Label name="detail-hp" text="0" class="detail-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label text="Steering" class="detail-key" />
                            <ui:Label name="detail-steering" text="0.0" class="detail-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label text="Speed" class="detail-key" />
                            <ui:Label name="detail-speed" text="0.0" class="detail-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label text="Fire Pow." class="detail-key" />
                            <ui:Label name="detail-fire" text="0.00" class="detail-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row detail-row-wings">
                            <ui:Label text="Wings" class="detail-key" />
                            <ui:Label name="wing-label" text="Wings 0/0" class="detail-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="detail-row">
                            <ui:Label text="Parts" class="detail-key" />
                            <ui:Label name="detail-parts" text="0" class="detail-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="preview-hint" text="Tap: Select | Drag: Move | Drag Pan: Canvas" class="preview-hint" />
                </ui:VisualElement>

                <ui:VisualElement name="stats-column" class="stats-column">
                    <ui:VisualElement name="stats-card" class="stats-card font-data">
                        <ui:VisualElement class="stat-row">
                            <ui:Label text="Name" class="stat-key" />
                            <ui:Label name="stat-name" text="-" class="stat-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-row">
                            <ui:Label text="Hp" class="stat-key" />
                            <ui:Label name="stat-hp" text="0" class="stat-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-row">
                            <ui:Label text="Fire pow." class="stat-key" />
                            <ui:Label name="stat-fire" text="0.00" class="stat-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-row">
                            <ui:Label text="Speed" class="stat-key" />
                            <ui:Label name="stat-speed" text="0.0" class="stat-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-row">
                            <ui:Label text="Steering" class="stat-key" />
                            <ui:Label name="stat-steering" text="0.0" class="stat-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-row">
                            <ui:Label text="Class" class="stat-key" />
                            <ui:Label name="stat-class" text="F" class="stat-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-row">
                            <ui:Label text="Parts" class="stat-key" />
                            <ui:Label name="stat-parts" text="0" class="stat-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-row">
                            <ui:Label text="Value" class="stat-key" />
                            <ui:Label name="stat-value" text="0" class="stat-value" />
                        </ui:VisualElement>
                        <ui:Label name="hull-label" text="-" class="hull-label" />
                    </ui:VisualElement>

                    <ui:Button name="back-to-center-button" class="sprite-button back-button" tooltip="Back to Center">
                        <app:SpriteElement name="button-art" class="button-art" scale-mode="ScaleAndCrop" sprite="project://database/Assets/Art/Sprites/UI/ui_0324_hangar_button_back_to_center.png" />
                    </ui:Button>
                    <ui:Button name="parts-crafts-button" class="sprite-button parts-crafts-button" tooltip="Parts / crafts">
                        <app:SpriteElement name="button-art" class="button-art" scale-mode="ScaleAndCrop" sprite="project://database/Assets/Art/Sprites/UI/ui_0404_hangar_button_parts_crafts.png" />
                    </ui:Button>
                    <ui:Label name="assembly-error" text="" class="error-label" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="table-area" class="table-area">
                <ui:VisualElement name="table-tabs" class="table-tabs">
                    <ui:Button name="tab-all" class="sprite-button tab-button" tooltip="All parts">
                        <app:SpriteElement name="button-art" class="button-art" scale-mode="ScaleAndCrop" sprite="project://database/Assets/Art/Sprites/UI/ui_0124_hangar_category_all.png" />
                    </ui:Button>
                    <ui:Button name="tab-body" class="sprite-button tab-button" tooltip="Body parts">
                        <app:SpriteElement name="button-art" class="button-art" scale-mode="ScaleAndCrop" sprite="project://database/Assets/Art/Sprites/UI/ui_0136_hangar_category_body.png" />
                    </ui:Button>
                    <ui:Button name="tab-wing" class="sprite-button tab-button" tooltip="Wing parts">
                        <app:SpriteElement name="button-art" class="button-art" scale-mode="ScaleAndCrop" sprite="project://database/Assets/Art/Sprites/UI/ui_0133_hangar_category_wing.png" />
                    </ui:Button>
                    <ui:Button name="tab-engine" class="sprite-button tab-button" tooltip="Engine parts">
                        <app:SpriteElement name="button-art" class="button-art" scale-mode="ScaleAndCrop" sprite="project://database/Assets/Art/Sprites/UI/ui_0130_hangar_category_engine.png" />
                    </ui:Button>
                    <ui:Button name="tab-gun" class="sprite-button tab-button" tooltip="Gun parts">
                        <app:SpriteElement name="button-art" class="button-art" scale-mode="ScaleAndCrop" sprite="project://database/Assets/Art/Sprites/UI/ui_0127_hangar_category_gun.png" />
                    </ui:Button>
                </ui:VisualElement>

                <ui:VisualElement name="table-header" class="table-header font-data">
                    <ui:Label text="Index" class="col col-index" />
                    <ui:Label text="Name" class="col col-name" />
                    <ui:Label text="Type" class="col col-type" />
                    <ui:Label text="L.R." class="col col-lr" />
                    <ui:Label text="Hp" class="col col-hp" />
                    <ui:Label text="Steering" class="col col-steering" />
                    <ui:Label text="Engine" class="col col-engine" />
                    <ui:Label text="Mass" class="col col-mass" />
                    <ui:Label text="Fire Power" class="col col-fire" />
                </ui:VisualElement>

                <ui:VisualElement name="crafts-header" class="table-header font-data">
                    <ui:Label text="Index" class="col col-index" />
                    <ui:Label text="Name" class="col col-name" />
                    <ui:Label text="" class="col col-actions" />
                </ui:VisualElement>

                <ui:ScrollView name="owned-parts-list" class="parts-table" />
                <ui:ScrollView name="crafts-list" class="parts-table" />

                <ui:VisualElement class="table-footer">
                    <ui:Button name="first-button" text="|&lt;" class="sprite-button page-button" tooltip="First page" />
                    <ui:Button name="prev-button" text="&lt;" class="sprite-button page-button" tooltip="Previous page" />
                    <ui:Label name="page-label" text="1 / 1" class="page-label font-sans" />
                    <ui:Button name="next-button" text="&gt;" class="sprite-button page-button" tooltip="Next page" />
                    <ui:Button name="last-button" text="&gt;|" class="sprite-button page-button" tooltip="Last page" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="factory-help" class="factory-help">
            <ui:VisualElement class="help-panel">
                <ui:Label name="help-title" text="FACTORY" class="help-title" />
                <ui:Label name="help-body" text="Pick a part row and merge it into the craft. Break a mounted part to send it back to inventory. New breaks everything except the chassis; Merge stores the craft and returns to the craft list." class="help-body" />
                <ui:Button name="help-close" text="BACK" class="text-button">
                    <app:SpriteElement name="button-art" class="button-art" scale-mode="ScaleAndCrop" sprite="project://database/Assets/Art/Sprites/UI/ui_0107_hangar_header.png" />
                    <ui:Label name="sprite-text" text="BACK" class="sprite-text" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
