<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="Hangar.uss" />
    <ui:VisualElement name="hangar-root" class="hangar-root">
        <ui:VisualElement name="hangar-screen" class="hangar-screen">
            <ui:VisualElement name="hangar-header" class="hangar-header">
                <ui:Label name="hangar-title" text="new / edit" class="hangar-title" />
                <ui:Label name="story-label" text="STORY 0" class="hangar-story" />
                <ui:Label name="money-label" text="0 G" class="hangar-money" />
                <ui:Button name="launch-button" class="sprite-button button-launch" tooltip="Launch" />
            </ui:VisualElement>

            <ui:VisualElement class="hangar-main">
                <ui:VisualElement class="preview-column">
                    <ui:VisualElement name="hangar-frame" class="hangar-frame">
                        <ui:VisualElement name="preview-clip" class="preview-clip">
                            <ui:VisualElement name="preview-canvas" class="preview-canvas" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Label name="preview-name" text="-" class="preview-name" />
                    <ui:VisualElement class="preview-actions">
                        <ui:Button name="merge-button" class="sprite-button button-merge" tooltip="Merge selected part" />
                        <ui:Button name="new-button" class="sprite-button button-new" tooltip="New craft" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="shop-column">
                    <ui:Label text="SHOP" class="section-title" />
                    <ui:ScrollView name="shop-stock-list" class="data-list shop-list" />
                    <ui:Label name="stack-total-label" text="STACK 0 G" class="stack-total" />
                    <ui:VisualElement class="shop-footer">
                        <ui:Button name="checkout-button" class="sprite-button button-accept" tooltip="Accept purchase" />
                        <ui:Button name="clear-stack-button" class="sprite-button button-reset" tooltip="Reset purchase stack" />
                    </ui:VisualElement>
                    <ui:Label name="shop-error" text="" class="error-label" />
                    <ui:Label text="SELL" class="section-title" />
                    <ui:ScrollView name="owned-sell-list" class="data-list sell-list" />
                </ui:VisualElement>

                <ui:VisualElement class="stats-column">
                    <ui:VisualElement name="stats-card" class="stats-card">
                        <ui:VisualElement class="stat-row">
                            <ui:Label text="Type" class="stat-key" />
                            <ui:Label name="stat-type" text="-" class="stat-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-row">
                            <ui:Label text="Name" class="stat-key" />
                            <ui:Label name="stat-name" text="-" class="stat-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-row">
                            <ui:Label text="Hp" class="stat-key" />
                            <ui:Label name="stat-hp" text="0" class="stat-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-row">
                            <ui:Label text="Str." class="stat-key" />
                            <ui:Label name="stat-strength" text="0/0" class="stat-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-row">
                            <ui:Label text="Eng." class="stat-key" />
                            <ui:Label name="stat-engine" text="0" class="stat-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-row">
                            <ui:Label text="Fire" class="stat-key" />
                            <ui:Label name="stat-fire" text="0.0" class="stat-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-row">
                            <ui:Label text="Mass" class="stat-key" />
                            <ui:Label name="stat-mass" text="0" class="stat-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="stat-row">
                            <ui:Label text="Value" class="stat-key" />
                            <ui:Label name="stat-value" text="0" class="stat-value" />
                        </ui:VisualElement>
                        <ui:Label name="hull-label" text="-" class="hull-label" />
                        <ui:Label name="wing-label" text="Wings 0/0" class="wing-label" />
                    </ui:VisualElement>
                    <ui:Button name="back-to-center-button" class="sprite-button button-back-to-center" tooltip="Back to center" />
                    <ui:Button name="parts-crafts-button" class="sprite-button button-parts-crafts" tooltip="Parts / crafts" />
                    <ui:Label name="assembly-error" text="" class="error-label" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement name="table-area" class="table-area">
                <ui:VisualElement class="table-tabs">
                    <ui:Button name="tab-all" class="sprite-button tab-button tab-all" tooltip="All parts" />
                    <ui:Button name="tab-body" class="sprite-button tab-button tab-body" tooltip="Body parts" />
                    <ui:Button name="tab-wing" class="sprite-button tab-button tab-wing" tooltip="Wing parts" />
                    <ui:Button name="tab-engine" class="sprite-button tab-button tab-engine" tooltip="Engine parts" />
                    <ui:Button name="tab-gun" class="sprite-button tab-button tab-gun" tooltip="Gun parts" />
                </ui:VisualElement>
                <ui:VisualElement name="table-header" class="table-header">
                    <ui:Label text="Index" class="col col-index" />
                    <ui:Label text="Name" class="col col-name" />
                    <ui:Label text="Type" class="col col-type" />
                    <ui:Label text="L.R." class="col col-lr" />
                    <ui:Label text="Hp" class="col col-hp" />
                    <ui:Label text="Steering" class="col col-steering" />
                    <ui:Label text="Engine" class="col col-engine" />
                    <ui:Label text="Mass" class="col col-mass" />
                    <ui:Label text="Fire Power" class="col col-fire" />
                    <ui:Label text="" class="col col-action" />
                </ui:VisualElement>
                <ui:ScrollView name="owned-parts-list" class="parts-table" />
                <ui:ScrollView name="crafts-list" class="parts-table" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
