/* Main menu (frozen 2011 UI_Main): responsive full-bleed composition.
   The menu recomposes the frozen layers: one starfield, the title lettering at
   the top, the ship centred between the title and the controls (ADR 0024). The
   six live buttons keep the frozen page proportions and carry the original widget
   art. Positions and sizes are authored here (ADR 0025); MainMenuController only
   anchors the bottom row, applies safe-area insets and fits the ship band.
   Page values at the 1920x1080 reference: title 460x99, buttons 161x45.
   Original game IP: Vargames (2011). */

.main-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgb(2, 4, 10);
    overflow: hidden;
}

.main-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.main-title {
    position: absolute;
    left: 0;
    top: 0;
    width: 68.97%; /* 460 / 667 page width */
    aspect-ratio: 4.6465; /* 460 x 99 */
}

/* UI Builder default; MainMenuController fits the live ship band at runtime. */
.main-ship {
    position: absolute;
    left: 27.3%;
    top: 22.4%;
    width: 45.3%;
    aspect-ratio: 1.2413; /* 427 x 344 */
}

.main-ui {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.menu-button {
    position: absolute;
    width: 24.14%; /* 161 / 667 page width */
    aspect-ratio: 3.5778; /* 161 x 45 */
    padding: 0;
    margin: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}

.menu-button:active {
    opacity: 0.86;
}

.button-art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.play-button {
    left: 3.02%; /* 20.15 / 667 */
    top: 82.68%;
}

.data-button {
    left: 26.47%; /* 176.55 / 667 */
    top: 82.68%;
}

.options-button {
    left: 50.34%; /* 335.75 / 667 */
    top: 82.68%;
}

.credits-button {
    left: 73.79%; /* 492.15 / 667 */
    top: 82.68%;
}

.link-button {
    left: 74.96%; /* 500 / 667 */
    top: 1.6%; /* 6 / 375 page height at the live reference */
}

.player-button {
    left: 74.96%; /* 500 / 667 */
    top: 12.26%;
}

.main-deferred {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.74);
}

.deferred-panel {
    width: 760px;
    min-height: 300px;
    padding: 40px 48px;
    justify-content: center;
    align-items: center;
    background-color: rgba(2, 8, 13, 0.96);
    border-width: 1px;
    border-color: rgba(0, 200, 236, 0.7);
}

.deferred-title {
    height: 64px;
    font-size: 40px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    -unity-text-align: middle-center;
    color: rgb(0, 226, 255);
}

.deferred-body {
    flex-grow: 1;
    font-size: 22px;
    -unity-text-align: middle-center;
    color: rgb(186, 220, 238);
    white-space: normal;
}

.deferred-back {
    min-width: 220px;
    height: 52px;
    margin-top: 26px;
    border-width: 1px;
    border-color: rgba(0, 200, 236, 0.7);
    background-color: rgba(4, 22, 32, 0.8);
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(0, 226, 255);
}
