/* Options (frozen 2011 UI_Options): 1920x1080.
   The committed page render carries the title plate, side chrome and OK/CANCEL
   plates. The six frozen rows plus the #179 control-mode row are live plates at
   the exact 2011 placements, so every value and toggle state is readable.
   The page is an overlay: the live main menu stays behind it and the tint is
   serialized on OptionsController, so the owner can tune it in the Inspector.
   Original game IP: Vargames (2011). */

.options-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.options-page {
    position: absolute;
    width: 850px;
    height: 490px;
    transform-origin: center;
}

.options-art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.button-art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.option-row {
    position: absolute;
    left: 333px;
    width: 180px;
    height: 31px;
    padding: 0 8px;
    margin: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border-width: 1px;
    border-color: rgb(171, 191, 220);
    border-radius: 2px;
    background-color: rgb(8, 8, 10);
}

.option-row:hover {
    border-color: rgb(149, 224, 242);
    background-color: rgb(12, 24, 34);
}

.option-row:active {
    background-color: rgb(4, 12, 18);
}

.option-row-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.option-row-state {
    font-size: 10px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(191, 215, 234);
}

.option-row:hover .option-row-state {
    color: rgb(0, 226, 255);
}

.bloom-row {
    top: 127.6px;
}

.candy-row {
    top: 163.15px;
}

.background-row {
    top: 198.7px;
}

.resolution-row {
    top: 234.25px;
}

.sound-row {
    top: 269.8px;
}

.music-row {
    top: 305.35px;
}

.control-row {
    top: 341.5px;
}

.control-hint {
    position: absolute;
    left: 333px;
    top: 438px;
    width: 300px;
    height: 22px;
    font-size: 10px;
    color: rgb(140, 196, 220);
}

.page-button {
    position: absolute;
    width: 118.7px;
    height: 42.2px;
    padding: 0;
    margin: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: stretch-to-fill;
}

.page-button:active {
    opacity: 0.86;
}

.ok-button {
    left: 279.15px;
    top: 376.7px;
}

.cancel-button {
    left: 450.65px;
    top: 376.7px;
}
