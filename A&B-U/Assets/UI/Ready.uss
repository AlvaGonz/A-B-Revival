/* Ready / Briefing: the frozen UI_MapBuilding page at 1920x1080 full-bleed.
   The page render is the composition base. Live elements sit in page-local pixels
   (851x521) and the whole page is scaled to cover the screen, so the metal panel,
   window frame and MAP LOADING badge keep their 2011 positions at every resolution.
   Frozen art is authored in Ready.uxml as app:SpriteElement (ADR 0025). */

.ready-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background-color: rgb(0, 0, 0);
}

.ready-page {
    position: absolute;
    width: 851px;
    height: 521px;
}

.ready-page-art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.button-art {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

.ready-window-fill {
    position: absolute;
    left: 241px;
    top: 72px;
    width: 374px;
    height: 263px;
    background-color: rgb(0, 0, 0);
}

.ready-title-plate {
    position: absolute;
    left: 345px;
    top: 90px;
    width: 150px;
    height: 42px;
    justify-content: center;
    align-items: center;
}

.ready-title {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    color: rgb(238, 250, 255);
    margin: 0;
    padding: 0;
}

.briefing-words {
    position: absolute;
    left: 290px;
    top: 140px;
    width: 270px;
    height: 150px;
    font-size: 24px;
    -unity-text-align: middle-center;
    white-space: normal;
    color: rgb(238, 246, 250);
    margin: 0;
    padding: 0;
}

.loadout-status {
    position: absolute;
    left: 270px;
    top: 305px;
    width: 300px;
    height: 16px;
    font-size: 11px;
    -unity-text-align: middle-center;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: rgb(130, 208, 224);
    margin: 0;
    padding: 0;
}

.sprite-button {
    position: absolute;
    border-width: 0;
    padding: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.sprite-button:hover {
    -unity-background-image-tint-color: rgb(190, 232, 255);
}

.sprite-button:active {
    -unity-background-image-tint-color: rgb(120, 190, 220);
}

.sprite-button:disabled {
    opacity: 0.4;
}

.launch-button {
    left: 354px;
    top: 370px;
    width: 139px;
    height: 63px;
}

/* The frozen page has no Back; the revival back plate sits in the top-left slack. */
.back-button {
    left: 110px;
    top: 30px;
    width: 120px;
    height: 38px;
}
