/* Shop (frozen 2011 UIShop): 1920x1080 full-bleed purchase screen.
   Sprite backgrounds are assigned at runtime from ShopController serialized fields. */

.shop-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgb(2, 4, 8);
    -unity-background-scale-mode: stretch-to-fill;
}

.shop-screen {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    padding: 16px 24px 14px 24px;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
}

.shop-header {
    height: 8%;
    min-height: 58px;
    flex-direction: row;
    align-items: center;
    padding: 0 8px 8px 8px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 168, 214, 0.55);
}

.title-plate {
    width: 300px;
    height: 60px;
    justify-content: center;
    align-items: center;
    -unity-background-scale-mode: scale-to-fit;
}

.shop-title {
    font-size: 30px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    color: rgb(0, 226, 255);
}

.header-spacer {
    flex-grow: 1;
}

.money-label {
    margin-right: 12px;
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(255, 214, 90);
}

.shop-panel {
    height: 28%;
    min-height: 230px;
    padding: 4px 8px;
    background-color: rgba(2, 8, 13, 0.94);
    border-width: 1px;
    border-color: rgba(0, 132, 168, 0.55);
    -unity-background-scale-mode: scale-to-fill;
    -unity-background-image-tint-color: rgb(58, 72, 86);
}

.table-header {
    height: 34px;
    flex-direction: row;
    align-items: center;
    padding: 0 8px;
    background-color: rgba(0, 34, 48, 0.92);
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 200, 236, 0.65);
}

.table-header .cell {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(148, 204, 230);
}

.shop-rows {
    flex-grow: 1;
    min-height: 0;
    flex-direction: column;
}

.shop-row {
    flex-grow: 1;
    min-height: 24px;
    flex-direction: row;
    align-items: center;
    padding: 0 8px;
    border-top-width: 1px;
    border-top-color: rgba(0, 190, 230, 0.38);
}

.shop-row-even {
    background-color: rgba(0, 118, 150, 0.30);
}

.shop-row-odd {
    background-color: rgba(0, 58, 82, 0.32);
}

.shop-row:hover {
    background-color: rgba(0, 170, 210, 0.40);
}

.shop-row-staged {
    background-color: rgba(0, 196, 236, 0.34);
}

.shop-row-empty {
    background-color: rgba(0, 24, 34, 0.18);
}

.shop-row .cell {
    font-size: 17px;
    color: rgb(204, 232, 246);
}

.shop-row-staged .col-sel {
    color: rgb(255, 232, 140);
    -unity-font-style: bold;
}

.shop-icon {
    width: 54px;
    height: 36px;
    margin-right: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.cell {
    margin: 0;
}

.col-icon {
    width: 54px;
}

.col-new {
    width: 76px;
}

.shop-new-slot {
    width: 76px;
    height: 32px;
    justify-content: flex-start;
    align-items: center;
}

.shop-new-badge {
    width: 72px;
    height: 30px;
    -unity-background-scale-mode: scale-to-fit;
}

.col-index {
    width: 64px;
}

.col-name {
    flex-grow: 1;
    min-width: 140px;
    overflow: hidden;
    -unity-text-overflow-position: middle;
}

.col-type {
    width: 82px;
}

.col-lr {
    width: 54px;
}

.col-hp {
    width: 76px;
    -unity-text-align: middle-right;
}

.col-steering {
    width: 88px;
    -unity-text-align: middle-right;
}

.col-engine {
    width: 88px;
    -unity-text-align: middle-right;
}

.col-mass {
    width: 76px;
    -unity-text-align: middle-right;
}

.col-fire {
    width: 100px;
    -unity-text-align: middle-right;
}

.col-value {
    width: 88px;
    -unity-text-align: middle-right;
}

.col-stock {
    width: 74px;
    -unity-text-align: middle-right;
}

.col-sel {
    width: 64px;
    -unity-text-align: middle-right;
}

.table-footer {
    height: 42px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.page-controls,
.filter-controls {
    flex-direction: row;
    align-items: center;
}

.page-button {
    width: 52px;
    height: 30px;
    margin-left: 4px;
    margin-right: 4px;
    border-width: 1px;
    border-color: rgba(0, 170, 214, 0.65);
    background-color: rgba(4, 22, 32, 0.72);
    -unity-font-style: bold;
    font-size: 18px;
    -unity-text-align: middle-center;
    color: rgb(0, 226, 255);
}

.page-label {
    width: 110px;
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(224, 240, 250);
}

.invert-button {
    width: 137px;
    height: 50px;
    -unity-background-scale-mode: scale-to-fit;
}

.help-button {
    width: 48px;
    height: 48px;
    margin-left: 12px;
    -unity-background-scale-mode: scale-to-fit;
}

.filter-button {
    width: 60px;
    height: 28px;
    margin-left: 4px;
    opacity: 0.55;
    -unity-background-scale-mode: scale-to-fit;
}

.filter-button.filter-active {
    opacity: 1;
}

.shop-middle {
    flex-grow: 1;
    min-height: 160px;
    flex-direction: row;
    padding: 8px 4px;
}

.trade-column {
    width: 22%;
    min-width: 180px;
    flex-direction: column;
    padding: 4px 10px;
}

.trade-label {
    height: 34px;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(224, 240, 250);
}

.trade-label.trade-negative {
    color: rgb(255, 96, 96);
}

.trade-spacer {
    flex-grow: 1;
}

.trade-button {
    margin-top: 8px;
    align-self: flex-start;
    -unity-background-scale-mode: scale-to-fit;
}

.accept-button {
    width: 182px;
    height: 72px;
}

.reset-button {
    width: 178px;
    height: 52px;
}

.center-button {
    width: 232px;
    height: 72px;
}

.detail-column {
    flex-grow: 1;
    flex-direction: row;
    min-width: 0;
}

.detail-card {
    flex-grow: 1;
    margin: 0 8px;
    padding: 8px 14px;
    background-color: rgba(2, 8, 13, 0.94);
    border-width: 1px;
    border-color: rgba(0, 132, 168, 0.55);
    -unity-background-scale-mode: scale-to-fill;
    -unity-background-image-tint-color: rgb(58, 72, 86);
}

.detail-title {
    height: 28px;
    font-size: 17px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(0, 226, 255);
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 200, 236, 0.65);
}

.detail-row {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 160, 205, 0.28);
}

.detail-key {
    width: 34%;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(148, 204, 230);
}

.detail-value {
    flex-grow: 1;
    font-size: 18px;
    -unity-text-align: middle-right;
    color: rgb(224, 240, 250);
    overflow: hidden;
    -unity-text-overflow-position: middle;
}

.action-column {
    width: 22%;
    min-width: 200px;
    flex-direction: column;
    padding: 4px 10px;
}

.error-label {
    height: 26px;
    margin-top: 6px;
    font-size: 15px;
    -unity-text-align: middle-center;
    color: rgb(255, 96, 96);
}

.sell-title-row {
    height: 32px;
    justify-content: center;
    align-items: flex-start;
    padding: 0 10px;
}

.player-label {
    font-size: 24px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(0, 226, 255);
}

.sprite-button {
    border-width: 0;
    padding: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-background-scale-mode: scale-and-crop;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.sprite-button:hover {
    -unity-background-image-tint-color: rgb(190, 232, 255);
}

.sprite-button:active {
    -unity-background-image-tint-color: rgb(120, 190, 220);
}

.sprite-button:disabled {
    opacity: 0.35;
}

.sprite-button.trade-button {
    -unity-background-scale-mode: scale-to-fit;
}

.sprite-button.invert-button,
.sprite-button.help-button {
    -unity-background-scale-mode: scale-to-fit;
}

.shop-help {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    display: none;
    justify-content: center;
    align-items: center;
    background-color: rgba(2, 4, 8, 0.94);
}

.shop-help-page {
    width: 76%;
    height: 92%;
    max-width: 1460px;
    max-height: 1000px;
    background-color: rgba(0, 0, 0, 0.92);
    -unity-background-scale-mode: scale-to-fit;
}

.shop-help-close {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    border-width: 0;
    padding: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
}

.shop-help-close:hover,
.shop-help-close:active {
    background-color: rgba(0, 0, 0, 0);
}
